# One Google key runs everything: planner (Gemini Flash), detection masks, and Nano Banana edits.
GEMINI_API_KEY=AIza...
# Optional: use the Anthropic API as the planner instead of Gemini (auto-selected when set)
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: pixel-accurate SAM-3 masks + LaMa/FLUX Fill via fal.ai (auto-selected when set)
# FAL_KEY=...
# --- tuning ---
GEMINI_PLANNER_MODEL=gemini-3.8-flash
GEMINI_PLANNER_THINKING=low
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_EDIT_MODEL=gemini-nano-banana-2.1
GEMINI_EDIT_RESOLUTION=2K
# QC_ENABLED=true           # vision QC verdict after every generative edit (~$0.004 each)
# QC_MODEL=gemini-3.8-flash  # defaults to the planner model
# PLANNER_PROVIDER=auto      # auto | anthropic | gemini | mock
# PUBLIC_BASE_URL=https://your-demo.example.com
# COCREATE_MOCK=1            # fully offline: keyword planner + placeholder masks
# --- accounts / tenant isolation ---
# AUTH_MODE=guest            # open = single user, no accounts · guest = private guest workspace for everyone, sign-up keeps it · required = login wall
# COOKIE_SECURE=true         # set behind https (Render's X-Forwarded-Proto is honoured automatically)
# AUTH_SHOW_RESET_LINK=false # dev only: return password-reset links in the API response when no mail server is configured
# SMTP_HOST=smtp.example.com # optional: send password-reset emails (otherwise the link is printed in the server log)
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=cocreate@example.com
